LINKEDIN_CLIENT_SECRET=""

# Email (for verification & notifications)
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@explorify.com"

# File Storage (AWS S3 or Cloudflare R2)
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET_NAME="explorify-documents"
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT=""

# Escrow (third-party integration)
ESCROW_API_KEY=""
ESCROW_WEBHOOK_SECRET=""

# Vercel (deployment)
VERCEL_TOKEN=""
VERCEL_ORG_ID=""
VERCEL_PROJECT_ID=""
