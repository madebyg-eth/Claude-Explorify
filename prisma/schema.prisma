generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(BUYER)
  verified      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  listings      Business[]       @relation("SellerListings")
  offers        Offer[]          @relation("BuyerOffers")
  buyerDeals    Deal[]           @relation("BuyerDeals")
  sellerDeals   Deal[]           @relation("SellerDeals")
  sentMessages  Message[]        @relation("SentMessages")
  notifications Notification[]
  savedListings SavedListing[]
  documents     DealDocument[]   @relation("UploadedDocuments")
}

enum UserRole {
  BUYER
  SELLER
  BOTH
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Business {
  id              String         @id @default(cuid())
  title           String
  slug            String         @unique
  description     String         @db.Text
  type            BusinessType
  status          BusinessStatus @default(ACTIVE)
  industry        String
  location        String
  askingPrice     Float
  revenue         Float
  ebitda          Float
  sde             Float
  multiple        Float
  yearEstablished Int
  employees       Int
  highlights      String[]
  tags            String[]
  images          String[]
  viewCount       Int            @default(0)
  sellerId        String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  seller         User           @relation("SellerListings", fields: [sellerId], references: [id])
  offers         Offer[]
  deals          Deal[]
  savedBy        SavedListing[]
  documents      BusinessDocument[]
}

enum BusinessType {
  SAAS
  ECOMMERCE
  SERVICE
  BRICK_AND_MORTAR
  CONTENT
  MARKETPLACE
  FRANCHISE
  MANUFACTURING
}

enum BusinessStatus {
  ACTIVE
  UNDER_OFFER
  SOLD
  DRAFT
}

model Offer {
  id         String      @id @default(cuid())
  businessId String
  buyerId    String
  amount     Float
  status     OfferStatus @default(PENDING)
  message    String?
  expiresAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  buyer    User     @relation("BuyerOffers", fields: [buyerId], references: [id])
  deal     Deal?
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  WITHDRAWN
}

model Deal {
  id            String       @id @default(cuid())
  businessId    String
  offerId       String       @unique
  buyerId       String
  sellerId      String
  status        DealStatus   @default(PENDING)
  escrowStatus  EscrowStatus @default(NOT_STARTED)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  business   Business       @relation(fields: [businessId], references: [id])
  offer      Offer          @relation(fields: [offerId], references: [id])
  buyer      User           @relation("BuyerDeals", fields: [buyerId], references: [id])
  seller     User           @relation("SellerDeals", fields: [sellerId], references: [id])
  milestones Milestone[]
  documents  DealDocument[]
  messages   Message[]
}

enum DealStatus {
  PENDING
  LOI_SUBMITTED
  DUE_DILIGENCE
  NEGOTIATION
  SIGNED
  CLOSED
  CANCELLED
}

enum EscrowStatus {
  NOT_STARTED
  DEPOSIT_HELD
  DUE_DILIGENCE
  FUNDS_RELEASED
  DISPUTED
  COMPLETED
}

model Milestone {
  id          String          @id @default(cuid())
  dealId      String
  title       String
  description String
  amount      Float
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())

  deal Deal @relation(fields: [dealId], references: [id])
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model DealDocument {
  id           String       @id @default(cuid())
  dealId       String
  uploadedById String
  name         String
  type         DocumentType
  url          String
  signedAt     DateTime?
  createdAt    DateTime     @default(now())

  deal       Deal @relation(fields: [dealId], references: [id])
  uploadedBy User @relation("UploadedDocuments", fields: [uploadedById], references: [id])
}

model BusinessDocument {
  id          String       @id @default(cuid())
  businessId  String
  name        String
  type        DocumentType
  url         String
  isPublic    Boolean      @default(false)
  ndaRequired Boolean      @default(true)
  createdAt   DateTime     @default(now())

  business Business @relation(fields: [businessId], references: [id])
}

enum DocumentType {
  LOI
  NDA
  PURCHASE_AGREEMENT
  TAX_RETURN
  FINANCIAL_STATEMENT
  INVENTORY_LIST
  CONTRACT
  BILL_OF_SALE
  OTHER
}

model Message {
  id        String    @id @default(cuid())
  dealId    String
  senderId  String
  content   String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  deal   Deal @relation(fields: [dealId], references: [id])
  sender User @relation("SentMessages", fields: [senderId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])
}

enum NotificationType {
  OFFER
  MESSAGE
  ESCROW
  DOCUMENT
  DEAL
  SYSTEM
}

model SavedListing {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@unique([userId, businessId])
}
